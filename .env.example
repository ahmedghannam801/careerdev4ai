# ---------------------------------------------------------------------------
# CareerDev4AI environment
#
# Copy to `.env` for local development. `.env` is gitignored.
#
# On Cloudflare Pages these are configured in the project's dashboard
# (Settings -> Environment variables) for both Production and Preview. Values
# prefixed with VITE_ are inlined into the browser bundle at BUILD time; every
# other value is a server-only secret available to the Pages Worker
# (`dist/_worker.js`) at runtime. Never put a secret in a VITE_ variable.
# `npx wrangler pages dev dist` loads this same file locally.
# ---------------------------------------------------------------------------

# --- Public / client-safe (inlined into the browser bundle) -----------------
# Supabase project URL and PUBLISHABLE (anon) key. These are designed to be
# public: row-level security is what protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# --- Server-only secrets (never exposed to the browser) ---------------------
# Supabase. Do not add a VITE_ prefix to the service-role key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google Gemini. Required for /api/copilot, /api/analyze-career,
# /api/optimize-cv, /api/mock-interview, /api/suggest-summary,
# /api/generate-cover-letter and the AI learning recommendations. Without it
# those routes return an explicit 503; no canned AI result is substituted.
GEMINI_API_KEY=<gemini-api-key>

# Optional: override the Gemini model (defaults to gemini-3.8-flash).
# GEMINI_MODEL="gemini-3.8-flash"

# Optional: the application's own daily AI budget, in requests per day.
#
#   AI_DAILY_LIMIT           per USER, per day (defaults to 15)
#   AI_PROJECT_DAILY_LIMIT   for the whole PROJECT, per day (defaults to 20)
#
# The provider enforces a daily quota per project and per model (20 requests
# a day on the free tier), so the application keeps its own budget to mirror
# it. The per-user allowance is deliberately smaller than the per-project one,
# so a single user cannot spend the whole project's allowance and lock
# everybody else out. When an allowance is exhausted the AI routes return 429
# with a Retry-After header rather than a generic error, and the provider's
# own quota error is reported the same way but with its own `code`.
# AI_DAILY_LIMIT=15
# AI_PROJECT_DAILY_LIMIT=20

# Optional: extra browser origins allowed to call the API (comma-separated).
# Same-origin requests are always allowed, so production normally needs none.
# Local development may set: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=

# Optional: the origin every public URL is built from. The default is the
# production domain, and the sitemap, the canonical links and the IndexNow
# submissions all follow this value.
# SITE_ORIGIN=https://careerdev4ai.pages.dev

# --- Search engines -----------------------------------------------------------
#
# Google Search Console. The verification file is published from
# `public/googleecc4c0f834a5c71c.html`; nothing else is needed to verify the
# domain by file. No environment variable is required.
#
# Google Analytics 4. The measurement id is PUBLIC — it identifies a property,
# not an account, and Google requires it in the page source. The application
# ships `G-KVH4XKTE23` by default; set this only to point a deployment at a
# different property.
# VITE_GA_MEASUREMENT_ID=G-KVH4XKTE23
#
# Google Analytics 4 — the Data API. These four are SERVER-ONLY secrets: they
# let the Admin Center read the property back and draw the traffic dashboard.
#
# The server authenticates with an OAuth 2.0 client that a person authorised
# once, with the read-only scope
# https://www.googleapis.com/auth/analytics.readonly. On every request the
# server exchanges the refresh token for a short-lived access token, so no
# service-account private key exists anywhere in the deployment — none has to
# be created, stored, rotated or leaked. The account that granted the
# authorisation needs "Read & analyze" access to the property in Google
# Analytics.
#
# Without these four the measurement still works, and the Admin Center shows
# a "not connected" panel that explains what to add.
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
# GA4_CLIENT_SECRET=<oauth-client-secret>
# GA4_REFRESH_TOKEN=<refresh-token>
#
# IndexNow. A key of 8-128 characters, kept on the server. The worker serves
# the key file the protocol requires at /<key>.txt, and notifies the search
# engines when a public opportunity or a learning resource is published. Leave
# it unset to switch the integration off.
# INDEXNOW_KEY=<random-key>

# Optional: Node server port for local development (defaults to 3000).
# PORT=3000

# --- Test environment (required by `npm test`) ------------------------------
#
# The suite reads these from the process environment or from `.env.test`
# (gitignored). Copy `.env.test.example` to `.env.test` and fill it in.
# Use a dedicated test project: the service-role key grants full access.
#
#   SUPABASE_URL=
#   SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=
