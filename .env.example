# GEMINI_API_KEY: Required for the AI routes (/api/copilot, /api/analyze-career,
# /api/optimize-cv, /api/mock-interview, /api/suggest-summary,
# /api/generate-cover-letter). Without it those routes return an explicit 503;
# no canned AI result is substituted.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional. Defaults to gemini-3.8-flash. Set this to another
# available Flash model (for example gemini-3.5-flash) when the default model
# is unavailable or its quota is exhausted.
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: Public base URL of the deployment. Optional; used for
# self-referential links.
APP_URL=

# ALLOWED_ORIGINS: Optional comma-separated list of extra browser origins
# allowed to call the API. Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Supabase (required for PostgreSQL persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Test environment (required by `npm test`)
#
# The test suite reads these three variables from the process environment, or
# from a `.env.test` file in the repository root.
#
#   .env.test  is GITIGNORED and must never be committed. Copy
#              `.env.test.example` to `.env.test` and fill it in.
#   Required:  SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Use a project that is safe to hold test data. The suite only ever creates
# and deletes its own `cp-test-*` identities and rows — it never truncates a
# table and never touches a row it did not create — but the service-role key
# below grants full access, so it must NEVER be a production key that is
# shared with anything else.
#
# The test credentials must never be production credentials.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable or anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Supabase — browser (Vite). Only the PUBLISHABLE/anon key may be exposed here.
# The service-role key must NEVER be used with a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
