{
  // Cloudflare Pages configuration.
  //
  // This file is the source of truth for the Pages project once it is deployed
  // with Wrangler (or once it is committed and the project is connected to
  // Git). The project name determines the free production URL:
  //   https://careerpilotai.pages.dev
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careerpilotai",
  "pages_build_output_dir": "./dist",

  // A compatibility date of 2026-08-04 or later enables Node.js compatibility
  // (nodejs_compat and nodejs_compat_v2) by default. That is what provides the
  // real `node:http` server implementation used by the Express API in
  // `dist/_worker.js`, so no explicit compatibility flag is needed here;
  // adding one is redundant at this compatibility date.
  "compatibility_date": "2026-09-01",

  // Keep preview deployments working against the same Worker build.
  "preview_urls": true
}
