{
  "name": "careerdev4ai",
  "private": true,
  "version": "1.0.0",
  "description": "A personal career operating system for goals, skills, roadmaps, CVs, applications and interview practice.",
  "type": "module",
  "scripts": {
    "dev": "npx --yes tsx server.ts",
    "start": "tsx server.ts",
    "prebuild": "node scripts/generate-favicon-ico.mjs",
    "build": "vite build && node scripts/build-worker.mjs",
    "prebuild:android": "node scripts/generate-favicon-ico.mjs",
    "build:android": "vite build --mode android --outDir dist-android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "brand": "node scripts/generate-brand-assets.mjs",
    "test": "node tests/runner.mjs",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name careerdev4ai --branch main",
    "cf:preview": "npm run build && wrangler pages deploy dist --project-name careerdev4ai --branch preview",
    "cf:deployments": "wrangler pages deployment list --project-name careerdev4ai",
    "cf:env": "node scripts/set-pages-env.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@google/genai": "^2.31.0",
    "@opentelemetry/api": "^1.10.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "unpdf": "^1.9.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "body-parser": ">=1.20.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "docx": "^9.14.0",
    "esbuild": "^0.28.2",
    "pdfkit": "^0.17.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
