# Template for the test environment. Copy to `.env.test` and fill in.
# `.env.test` is gitignored — never commit real credentials.
#
# `npm test` reads these three variables from the process environment first,
# and falls back to this file. If any of them is missing the run stops
# immediately with a message naming the variable.
#
# The suite only creates and deletes its own `cp-test-*` Supabase Auth
# identities and rows; it never truncates and never touches rows it did not
# create. Still, point it at a project you are happy to have test data in.
#
# These must NEVER be production credentials: the service-role key grants full
# access to the database, and the suite is a test suite.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable or anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
