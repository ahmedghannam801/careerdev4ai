node_modules/
build/
dist/
dist-android/
coverage/
.DS_Store
*.log
.env*
!.env.example
!.env.test.example
!.env.android
.env.test

.careerpilot_state.json
secrets/
credentials/
local_db/
*.tmp
*.upload

# Local Cloudflare/Wrangler state and scratch QA artifacts (never shipped).
.wrangler/
.tmp-qa/

# The screenshots and the report the QA scripts in the repository root write
# when they sweep the built site. The scripts are the source and are tracked;
# what they produce is an artifact of one run and is not.
.qa/

# The raw output of a test run.
.test-output.txt

# A temporary upload fixture a test run leaves behind.
tests/.tmp-job-description-upload/

# The output of the Playwright end-to-end run (never shipped).
test-results/
playwright-report/
blob-report/

# The sample documents the export scripts produce (never shipped).
# They are regenerated by `npx tsx scripts/generate-cv-samples.mts`, and the
# scripts that check them read the files back with an independent reader.
samples/

# The bundle of the background-job Worker (built by scripts/build-jobs-worker.mjs).
dist-jobs/

# The redirect-only deployment of the predecessor origin
# (built by scripts/build-legacy-redirect.mjs).
dist-legacy-redirect/

# The secrets file the background-job Worker's secrets are uploaded from.
# It holds live credentials and must never be committed.
.wrangler-secrets.json

# Local Android build toolchain (JDK and Android SDK downloaded for the build).
.tools/

# Local Supabase CLI state (project ref, pooler URL — machine specific)
supabase/.temp/
.dyad/
