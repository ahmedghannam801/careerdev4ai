# Security headers for the static app (Cloudflare Pages).
#
# The API responses are produced by the Pages Worker (`dist/_worker.js`), which
# applies the same baseline headers in `app.ts`. These rules cover the HTML,
# CSS, JS and image assets served directly from the Pages CDN.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://ciihprsfdojzvjnqgbxl.supabase.co wss://ciihprsfdojzvjnqgbxl.supabase.co https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; worker-src 'self' blob:; manifest-src 'self'

# Hashed build assets are immutable: a new build produces a new file name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML document must always be revalidated so a new deployment is picked up.
/
  Cache-Control: public, max-age=0, must-revalidate
