# ---------------------------------------------------------------------------
# CareerDev4AI — Android (Capacitor) build environment
# ---------------------------------------------------------------------------
#
# Vite reads this file when the bundle is built with `--mode android`
# (`npm run build:android`). It pins the native build to the PRODUCTION
# deployment, so the Android application can never end up talking to a
# development API or to a test Supabase project.
#
#   VITE_API_BASE_URL  the origin that serves the application's own API. It is
#                       empty in the web build, where every request stays
#                       same-origin; here it is the production deployment.
#
#   VITE_SUPABASE_URL  the production Supabase project.
#
# The Supabase publishable key is not repeated here: like every other build of
# this project it is read from `.env`. It is the publishable (anon) key of the
# production project — never the service-role key.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=https://careerdev4ai.pages.dev
VITE_SUPABASE_URL=https://ciihprsfdojzvjnqgbxl.supabase.co
